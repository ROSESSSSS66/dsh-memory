{
  "name": "dsh-memory",
  "version": "0.11.0",
  "icon": "assets/icon.svg",
  "description": "Zero-dependency local-first long-term memory plugin for DeepSeek Desktop (DSH): full in-memory vector matrix + SQLite FTS5 hybrid recall (10k p95 < 10ms), Hindsight & OpenViking insights, 4 lean model tools, optional OpenAI-compatible embeddings, and autonomous background self-evolution.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "agent-memory",
    "long-term-memory",
    "self-evolving",
    "autonomous",
    "claude-style",
    "hipporag",
    "synapse",
    "lightmem",
    "a-mem",
    "letta",
    "mem0",
    "hindsight",
    "openviking",
    "sqlite-fts5",
    "hybrid-retrieval"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ROSESSSSS66/dsh-memory.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "dsh": ">=0.2.0-rc.1 <1.0.0 || ^0.2.1-rc.0 || ^0.2.2-rc.0 || ^0.2.3-rc.0 || ^0.2.4-rc.0 || ^0.2.5-rc.0 || >=0.3.0-rc.0 <1.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/client.js",
    "src/core/migrations",
    "scripts/postinstall.mjs",
    "locale",
    "assets/icon.svg",
    "assets/icon.png",
    "assets/screenshot-*.png",
    "screenshots.json",
    "README.md",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*": "./locale/*"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsup && npm run build:client",
    "build:client": "node scripts/build-client.mjs",
    "init": "node scripts/postinstall.mjs --force",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src scripts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test",
    "eval": "node scripts/run-eval.mjs",
    "pack:check": "node scripts/verify-pack.mjs",
    "prepublishOnly": "npm run check && npm run build && npm run eval"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <1.0.0 || ^0.2.1-rc.0 || ^0.2.2-rc.0 || ^0.2.3-rc.0 || ^0.2.4-rc.0 || ^0.2.5-rc.0 || >=0.3.0-rc.0 <1.0.0",
    "@deepseek-ai/schemastery": ">=3.18.0 <4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.27.7",
    "fzstd": "^0.1.1",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^4.6.7"
  }
}
